# Salin ke .env lalu isi nilainya. JANGAN commit .env.

# --- Wokwi CLI (token dari https://wokwi.com/dashboard/ci) ---
WOKWI_CLI_TOKEN=

# --- MQTT: HiveMQ public broker (TLS, tanpa login) ---
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TOPIC_PREFIX=sic8-montblanc/iris
# Kosongkan untuk broker publik. Isi hanya jika pindah ke broker ber-autentikasi (mis. HiveMQ Cloud).
MQTT_USERNAME=
MQTT_PASSWORD=

# --- WiFi ESP32 (di Wokwi pakai Wokwi-GUEST tanpa password) ---
WIFI_SSID=Wokwi-GUEST
WIFI_PASSWORD=

# --- Kaggle (untuk unduh SH17; isi salah satu: token baru ATAU username+key) ---
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
