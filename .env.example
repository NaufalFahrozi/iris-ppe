# Salin ke .env lalu isi nilainya. JANGAN commit .env.

# --- Wokwi CLI (token dari https://wokwi.com/dashboard/ci) ---
WOKWI_CLI_TOKEN=

# --- HiveMQ Cloud (kredensial khusus demo, bisa dicabut) ---
MQTT_HOST=            # contoh: xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- WiFi ESP32 (di Wokwi pakai Wokwi-GUEST tanpa password) ---
WIFI_SSID=Wokwi-GUEST
WIFI_PASSWORD=

# --- Kaggle (opsional, hanya jika unduhan anonim SH17 gagal) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
