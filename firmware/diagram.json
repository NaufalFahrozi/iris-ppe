{
  "version": 1,
  "author": "Tim Montblanc",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },

    { "type": "board-ssd1306", "id": "oled1", "top": -150, "left": 150, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 10, "left": 250, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-servo", "id": "servo1", "top": 140, "left": 240, "attrs": { "horn": "single" } },

    { "type": "wokwi-led", "id": "led_g", "top": -110, "left": -230, "attrs": { "color": "green", "label": "OK" } },
    { "type": "wokwi-led", "id": "led_y", "top": -110, "left": -180, "attrs": { "color": "yellow", "label": "WARN" } },
    { "type": "wokwi-led", "id": "led_r", "top": -110, "left": -130, "attrs": { "color": "red", "label": "ALARM" } },
    { "type": "wokwi-resistor", "id": "r_g", "top": -30, "left": -240, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_y", "top": -30, "left": -190, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r_r", "top": -30, "left": -140, "rotate": 90, "attrs": { "value": "220" } },

    { "type": "wokwi-slide-switch", "id": "sw_role", "top": -190, "left": -60, "attrs": { "value": "", "bounce": "0" } },
    { "type": "wokwi-slide-switch", "id": "sw_source", "top": -190, "left": 20, "attrs": { "value": "1", "bounce": "0" } },

    { "type": "wokwi-pushbutton", "id": "btn_person", "top": 60, "left": -250, "attrs": { "color": "blue", "label": "PERSON", "bounce": "0" } },
    { "type": "wokwi-pushbutton", "id": "btn_helmet", "top": 120, "left": -250, "attrs": { "color": "yellow", "label": "HELMET", "bounce": "0" } },
    { "type": "wokwi-pushbutton", "id": "btn_vest", "top": 180, "left": -250, "attrs": { "color": "green", "label": "VEST", "bounce": "0" } },
    { "type": "wokwi-pushbutton", "id": "btn_reset", "top": 240, "left": -250, "attrs": { "color": "red", "label": "RESET", "bounce": "0" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "oled1:GND", "esp:GND.2", "black", [] ],
    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:SCL", "esp:22", "purple", [] ],
    [ "oled1:SDA", "esp:21", "orange", [] ],

    [ "bz1:1", "esp:GND.3", "black", [] ],
    [ "bz1:2", "esp:19", "magenta", [] ],

    [ "servo1:GND", "esp:GND.3", "black", [] ],
    [ "servo1:V+", "esp:5V", "red", [] ],
    [ "servo1:PWM", "esp:18", "orange", [] ],

    [ "esp:25", "r_g:2", "green", [] ],
    [ "r_g:1", "led_g:A", "green", [] ],
    [ "led_g:C", "esp:GND.1", "black", [] ],
    [ "esp:26", "r_y:2", "gold", [] ],
    [ "r_y:1", "led_y:A", "gold", [] ],
    [ "led_y:C", "esp:GND.1", "black", [] ],
    [ "esp:27", "r_r:2", "red", [] ],
    [ "r_r:1", "led_r:A", "red", [] ],
    [ "led_r:C", "esp:GND.1", "black", [] ],

    [ "sw_role:1", "esp:GND.1", "black", [] ],
    [ "sw_role:2", "esp:34", "cyan", [] ],
    [ "sw_role:3", "esp:3V3", "red", [] ],
    [ "sw_source:1", "esp:GND.1", "black", [] ],
    [ "sw_source:2", "esp:35", "cyan", [] ],
    [ "sw_source:3", "esp:3V3", "red", [] ],

    [ "btn_person:1.r", "esp:32", "blue", [] ],
    [ "btn_person:2.r", "esp:GND.1", "black", [] ],
    [ "btn_helmet:1.r", "esp:33", "yellow", [] ],
    [ "btn_helmet:2.r", "esp:GND.1", "black", [] ],
    [ "btn_vest:1.r", "esp:14", "green", [] ],
    [ "btn_vest:2.r", "esp:GND.1", "black", [] ],
    [ "btn_reset:1.r", "esp:13", "red", [] ],
    [ "btn_reset:2.r", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
