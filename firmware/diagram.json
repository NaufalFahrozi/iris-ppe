{
  "version": 1,
  "author": "Tim Montblanc",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": -20, "left": 180, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 60, "left": 150, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 150, "left": 180, "attrs": { "color": "blue", "bounce": "0" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:26", "r1:1", "green", [] ],
    [ "r1:2", "led1:A", "green", [] ],
    [ "led1:C", "esp:GND.2", "black", [] ],
    [ "esp:27", "btn1:1.l", "blue", [] ],
    [ "btn1:2.l", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
